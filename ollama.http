@baseUrl = http://localhost:11434
@authorization = Bearer {{$dotenv OLLAMA_API_KEY}}
#llama3.2:1b, llama3.2:3b,deepseek-v2:16b, qwen3:4b, qwen3:8b, qwen2.5-coder:7b, gemma3:4b
@model = qwen2.5-coder:7b

### Health/version check
GET {{baseUrl}}/
Authorization: {{authorization}}

### List local models
GET {{baseUrl}}/api/tags
Authorization: {{authorization}}

### Show model details
POST {{baseUrl}}/api/show
Content-Type: application/json
Authorization: {{authorization}}

{
  "name": "{{model}}"
}

### Pull model from registry
POST {{baseUrl}}/api/pull
Content-Type: application/json
Authorization: {{authorization}}

{
  "name": "{{model}}",
  "stream": false
}

### Push model to registry
POST {{baseUrl}}/api/push
Content-Type: application/json
Authorization: {{authorization}}

{
  "name": "{{model}}",
  "stream": false
}

### Create model from Modelfile
POST {{baseUrl}}/api/create
Content-Type: application/json
Authorization: {{authorization}}

{
  "name": "my-custom-model",
  "path": "./Modelfile",
  "stream": false
}

### Copy model
POST {{baseUrl}}/api/copy
Content-Type: application/json
Authorization: {{authorization}}

{
  "source": "{{model}}",
  "destination": "llama3.1-copy"
}

### Delete model
DELETE {{baseUrl}}/api/delete
Content-Type: application/json
Authorization: {{authorization}}

{
  "name": "llama3.1-copy"
}

### Generate text (non-streaming)
POST {{baseUrl}}/api/generate
Content-Type: application/json
Authorization: {{authorization}}

{
  "model": "{{model}}",
  "prompt": "Write a short haiku about inference.",
  "stream": false
}

### Quick response: hello
POST {{baseUrl}}/api/generate
Content-Type: application/json
Authorization: {{authorization}}

{
  "model": "{{model}}",
  "prompt": "Say hello in one short sentence.",
  "stream": false,
  "options": {
    "num_predict": 16
  }
}

### Quick response: simple question
POST {{baseUrl}}/api/generate
Content-Type: application/json
Authorization: {{authorization}}

{
  "model": "{{model}}",
  "prompt": "What is 2 + 2? Answer with only the number.",
  "stream": false,
  "options": {
    "num_predict": 8
  }
}

### Generate text (streaming)
POST {{baseUrl}}/api/generate
Content-Type: application/json
Authorization: {{authorization}}

{
  "model": "{{model}}",
  "prompt": "Count from 1 to 5.",
  "stream": true
}

### Chat completion (non-streaming)
POST {{baseUrl}}/api/chat
Content-Type: application/json
Authorization: {{authorization}}

{
  "model": "{{model}}",
  "messages": [
    { "role": "system", "content": "You are concise." },
    { "role": "user", "content": "What is Ollama in one sentence?" }
  ],
  "stream": false
}

### Quick chat response
POST {{baseUrl}}/api/chat
Content-Type: application/json
Authorization: {{authorization}}

{
  "model": "{{model}}",
  "messages": [
    { "role": "user", "content": "Hello! How are you?" }
  ],
  "stream": false,
  "options": {
    "num_predict": 16
  }
}

### Chat completion (streaming)
POST {{baseUrl}}/api/chat
Content-Type: application/json
Authorization: {{authorization}}

{
  "model": "{{model}}",
  "messages": [
    { "role": "user", "content": "Give me 3 bullet points about GPU inference." }
  ],
  "stream": true
}

### Embeddings (single input)
POST {{baseUrl}}/api/embeddings
Content-Type: application/json
Authorization: {{authorization}}

{
  "model": "{{model}}",
  "prompt": "The quick brown fox jumps over the lazy dog."
}

### Embeddings (batch input)
POST {{baseUrl}}/api/embed
Content-Type: application/json
Authorization: {{authorization}}

{
  "model": "{{model}}",
  "input": [
    "First document",
    "Second document"
  ]
}

### List running models
GET {{baseUrl}}/api/ps
Authorization: {{authorization}}

### Raw REST API docs endpoint (if enabled by your Ollama version/build)
GET {{baseUrl}}/api
Authorization: {{authorization}}
